package-as: TotemHud

# assets ships the in-game .tga icon, the alert clips, and the monospace
# font with its license; the png master is project art and the .m4a
# voice recordings are source material, so both stay repo-only
ignore:
  - assets/logo.png
  - assets/*.m4a
  - README.md
  - .gitattributes
  - etc
